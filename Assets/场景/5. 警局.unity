  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a5f6315f89dc4cedb3f244325cfc66e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionMode: 0
  interactKey: 101
  freezePlayerDuringDialogue: 1
  requiredMaskId: Mask3
  silentWhenLocked: 0
  lockedLines:
  - Nope
  mainLines:
  - "\u2026That mask.\n"
  - "I haven\u2019t seen it in a while."
  - "This hit-and-run wasn\u2019t the worst part."
  - It was connected to something bigger.
  - The snowman case.
  - "That\u2019s where everything collapsed."
  - 'There was a girl who fell into a coma back then.

'
  - Mei.
  - 'I wonder if she ever woke up.

'
  - 'She was a key witness.

'
  - "If she can speak, we won\u2019t need that cop who was suspended for concealing
    evidence anymore. "
  - His testimony is not important anymore.
  - The truth would be enough on its own.
  afterDialogueLines: []
  rewardMaskAfterTalk: 1
