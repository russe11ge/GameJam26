      m_Calls: []
  m_text: "Mei. \nThe name doesn\u2019t feel distant. It feels heavy. \nThey weren\u2019t
    talking about someone else. I was the one who collapsed. \nI was the witness
    they were waiting for. I didn\u2019t disappear. \nI stayed alive and forgot.
    \n\n"
  m_isRightToLeft: 0
