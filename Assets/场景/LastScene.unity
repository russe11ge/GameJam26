--- !u!114 &181994032
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 181994030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "My name is Mei. I come from a poor family, and throughout college I survived
    by saving every possible expense and working late-night part-time jobs. That
    night, after finishing my shift at a bar, I was walking back to campus through
    a narrow alley when I saw a sports car speed into it. A moment later, I heard
    a dull, heavy impact. There had only been a pair of young people in the alley,
    who looked like siblings. The girl was struck and thrown aside, dying on the
    spot. I clearly recognized the four people who stepped out of the car\u2014they
    were the girls from Room 209 in our dormitory building, well-off, always conspicuous
    at school. They glanced at the scene, showed no panic, did not call the police,
    and simply threw down a stack of cash before leaving. I realized it was fifty
    thousand yuan\u2014enough, in that era, to bury almost anything. I took photos
    of everything. The young man noticed me. Holding his sister\u2019s body, he was
    on the edge of collapse, yet spoke with terrifying clarity: people with money
    are not afraid of prison; they can make anything disappear. He said he would
    make them pay with their lives. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0d31a543563d72d4885373c401d2d483, type: 2}
  m_sharedMaterial: {fileID: 8071613318806429051, guid: 0d31a543563d72d4885373c401d2d483, type: 2}
