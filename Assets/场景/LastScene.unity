  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Two days later, driven by tuition deadlines and my father\u2019s illness,
    I still went to Room 209 to blackmail them. At around two in the morning, I stood
    outside their door and heard sounds that were unmistakably wrong. Through a crack
    in the door, I saw that he had already killed several of them and was dismembering
    the bodies. The last one was still alive, hanging from the ceiling fan, slowly
    turning, whispering pleas. I completely lost control, fled back to my room, and
    hid in silence. Later, I heard his voice in the hallway, saying his sister loved
    building snowmen, and that he would let them all stay together inside one. Before
    I lost consciousness, I glanced out the window and saw a blurred figure placing
    something into a snowman."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0d31a543563d72d4885373c401d2d483, type: 2}
  m_sharedMaterial: {fileID: 8071613318806429051, guid: 0d31a543563d72d4885373c401d2d483, type: 2}
