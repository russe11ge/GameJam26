  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "During the internal investigation, police discovered that the case was
    highly likely related to an unreported hit-and-run accident that occurred a few
    days earlier. There was a clear connection between the vehicle involved and several
    of the murdered female students. However, this line of inquiry was terminated
    before it was officially recorded. A police officer in charge of the case insisted
    that it was a revenge-driven serial killing committed by a witness, and that
    the hit-and-run incident was protected by obvious social and class privileges.
    The officer was subsequently suspended for \"improperly withholding evidence
    and failing to follow reporting procedures,\" and all related materials were
    removed from the case file. The only potential witness, a female student named
    Mei who lived on the same dormitory floor, fell into a coma. Due to the \"inability
    to determine the motive or identity of the perpetrator,\" the case was ultimately
    classified as unsolved, and the initial cause of the crime\u2014the hit-and-run
    accident in the alley\u2014was never mentioned in any public record."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0d31a543563d72d4885373c401d2d483, type: 2}
  m_sharedMaterial: {fileID: 8071613318806429051, guid: 0d31a543563d72d4885373c401d2d483, type: 2}
